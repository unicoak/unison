# PostgreSQL connection string (Neon, Supabase, или другой Postgres)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Секрет для подписи сессий Auth.js — сгенерировать: openssl rand -base64 32
AUTH_SECRET="change-me"

# Первый аккаунт с ролью "бог" (создаётся сид-скриптом)
GOD_EMAIL="admin@example.com"
GOD_PASSWORD="change-me-please"
GOD_NAME="Админ"

# S3-совместимое хранилище файлов домашек (например, Timeweb S3).
# Без этих переменных в dev-режиме файлы пишутся во временную папку —
# в проде так делать нельзя, файлы не переживут перезапуск.
S3_ENDPOINT="https://s3.twcstorage.ru"
S3_REGION="ru-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET=""
# Опционально — если публичный URL бакета отличается от ENDPOINT/BUCKET
S3_PUBLIC_URL=""
