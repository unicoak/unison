generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  GOD
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  avatarUrl    String?
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())

  studentProfile      StudentProfile?
  createdQuests       Quest[]           @relation("QuestCreator")
  questAssignments    QuestAssignment[]
  submissions         QuestSubmission[] @relation("SubmissionStudent")
  reviewedSubmissions QuestSubmission[] @relation("SubmissionReviewer")
  achievementsGiven   UserAchievement[] @relation("AchievementAwarder")
  achievements        UserAchievement[] @relation("AchievementOwner")
  createdTests        Test[]            @relation("TestCreator")
  testAssignments     TestAssignment[]
  testAttempts        TestAttempt[]     @relation("AttemptStudent")
  reviewedAttempts    TestAttempt[]     @relation("AttemptReviewer")
  xpTransactions      XpTransaction[]   @relation("XpOwner")
  xpGiven             XpTransaction[]   @relation("XpGiver")
  forumTopics         ForumTopic[]
  forumPosts          ForumPost[]
}

model StudentProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  xp              Int      @default(0)
  level           Int      @default(1)
  title           String   @default("Новичок")
  celebrateLevel  Int?
  updatedAt       DateTime @updatedAt
}

model LevelDefinition {
  level      Int    @id
  requiredXp Int
  title      String
}

model Achievement {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String
  icon        String
  secret      Boolean  @default(false)
  createdAt   DateTime @default(now())

  awardedTo UserAchievement[]
  quests    Quest[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation("AchievementOwner", fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  awardedAt     DateTime    @default(now())
  awardedById   String?
  awardedBy     User?       @relation("AchievementAwarder", fields: [awardedById], references: [id])

  @@unique([userId, achievementId])
}

enum QuestStatus {
  OPEN
  CLOSED
}

model Quest {
  id          String      @id @default(cuid())
  title       String
  description String
  xpReward    Int
  dueAt       DateTime?
  // Students see the quest only from this moment (null = immediately).
  availableAt DateTime?
  status      QuestStatus @default(OPEN)
  createdById String
  createdBy   User        @relation("QuestCreator", fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())

  // Awarded automatically to the student when their submission is approved.
  achievementId String?
  achievement   Achievement? @relation(fields: [achievementId], references: [id], onDelete: SetNull)

  assignments QuestAssignment[]
  submissions QuestSubmission[]
}

model QuestAssignment {
  id         String   @id @default(cuid())
  questId    String
  quest      Quest    @relation(fields: [questId], references: [id], onDelete: Cascade)
  studentId  String
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([questId, studentId])
}

enum SubmissionStatus {
  SUBMITTED
  APPROVED
  NEEDS_REVISION
  REJECTED
}

model QuestSubmission {
  id             String           @id @default(cuid())
  questId        String
  quest          Quest            @relation(fields: [questId], references: [id], onDelete: Cascade)
  studentId      String
  student        User             @relation("SubmissionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  textContent    String?
  links          String[]         @default([])
  status         SubmissionStatus @default(SUBMITTED)
  teacherComment String?
  xpAwarded      Int?
  submittedAt    DateTime         @default(now())
  reviewedAt     DateTime?
  reviewedById   String?
  reviewedBy     User?            @relation("SubmissionReviewer", fields: [reviewedById], references: [id])

  files SubmissionFile[]

  @@unique([questId, studentId])
}

enum AttachmentType {
  IMAGE
  VIDEO
  OTHER
}

model SubmissionFile {
  id           String          @id @default(cuid())
  submissionId String
  submission   QuestSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  url          String
  type         AttachmentType
  filename     String
  size         Int
  createdAt    DateTime        @default(now())
}

// dayOfWeek: 1=Пн ... 7=Вс
model ScheduleSlot {
  id        String   @id @default(cuid())
  dayOfWeek Int
  startTime String
  endTime   String
  subject   String
  location  String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CurriculumSection {
  id          String   @id @default(cuid())
  title       String
  order       Int
  period      String
  description String
  resources   Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ForumTopic {
  id        String   @id @default(cuid())
  title     String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  posts ForumPost[]

  @@index([createdAt])
}

model ForumPost {
  id        String     @id @default(cuid())
  topicId   String
  topic     ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  authorId  String
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime   @default(now())

  @@index([topicId, createdAt])
}

enum TestQuestionType {
  CHOICE // pick one of the prepared options, graded automatically
  TEXT   // free-form answer, graded by a teacher
}

enum TestAttemptStatus {
  SUBMITTED // waiting for a teacher to grade the free-form answers
  GRADED
}

model Test {
  id          String   @id @default(cuid())
  title       String
  description String?
  createdById String
  createdBy   User     @relation("TestCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  questions   TestQuestion[]
  assignments TestAssignment[]
  attempts    TestAttempt[]
}

model TestQuestion {
  id       String           @id @default(cuid())
  testId   String
  test     Test             @relation(fields: [testId], references: [id], onDelete: Cascade)
  order    Int
  type     TestQuestionType
  text     String
  imageUrl String?
  points   Int              @default(1)

  options TestOption[]
  answers TestAnswer[]

  @@index([testId, order])
}

model TestOption {
  id         String       @id @default(cuid())
  questionId String
  question   TestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int
  text       String
  isCorrect  Boolean      @default(false)

  answers TestAnswer[]
}

model TestAssignment {
  id         String   @id @default(cuid())
  testId     String
  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId  String
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([testId, studentId])
}

model TestAttempt {
  id           String            @id @default(cuid())
  testId       String
  test         Test              @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId    String
  student      User              @relation("AttemptStudent", fields: [studentId], references: [id], onDelete: Cascade)
  status       TestAttemptStatus @default(SUBMITTED)
  score        Int               @default(0)
  maxScore     Int
  submittedAt  DateTime          @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?             @relation("AttemptReviewer", fields: [reviewedById], references: [id])

  answers TestAnswer[]

  @@unique([testId, studentId])
}

model TestAnswer {
  id             String       @id @default(cuid())
  attemptId      String
  attempt        TestAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId     String
  question       TestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionId       String?
  option         TestOption?  @relation(fields: [optionId], references: [id], onDelete: SetNull)
  textAnswer     String?
  pointsAwarded  Int?
  teacherComment String?

  @@unique([attemptId, questionId])
}

// Ledger of every XP change; StudentProfile.xp stays the running total.
model XpTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("XpOwner", fields: [userId], references: [id], onDelete: Cascade)
  amount      Int
  reason      String
  createdById String?
  createdBy   User?    @relation("XpGiver", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}
